# Copy to .env and fill in ONE provider key.

# Default provider: Google Gemini (free tier). Key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# LLM_PROVIDER=google_genai
# LLM_MODEL=gemini-3.7-flash

# Alternative: Groq (free tier with rate limits). Key: https://console.groq.com/keys
# Model names change; pick a tool-calling model from https://console.groq.com/docs/models
# GROQ_API_KEY=
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b

# Optional: pretend today is a given date (the sample orders are from 2025-2026, so every
# real return would be expired). Used to demo an eligible return, e.g.:
# AGENT_TODAY=2026-02-20

# Optional: where complaints and human-handoff requests are saved (default: ./complaints.jsonl, git-ignored)
# COMPLAINTS_FILE=complaints.jsonl
